{
  "name": "portflow-ai",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:spec-kit": "node --test scripts/spec-kit/*.test.mjs",
    "typecheck": "turbo run typecheck",
    "spec:workflow": "node scripts/spec-kit/delivery.mjs",
    "spec:workflow:legacy": "node scripts/spec-kit/workflow.mjs",
    "delivery:start": "node scripts/spec-kit/delivery.mjs start",
    "delivery:status": "node scripts/spec-kit/delivery.mjs status",
    "delivery:approve": "node scripts/spec-kit/delivery.mjs approve",
    "delivery:continue": "node scripts/spec-kit/delivery.mjs continue",
    "delivery:review": "node scripts/spec-kit/delivery.mjs review",
    "delivery:validate": "node scripts/spec-kit/delivery.mjs validate",
    "delivery:adopt": "node scripts/spec-kit/delivery.mjs adopt",
    "project:kanban": "node scripts/spec-kit/simplify-project-kanban.mjs",
    "project:kanban:legacy": "node scripts/spec-kit/configure-project-kanban.mjs",
    "project:simplify": "node scripts/spec-kit/simplify-project-kanban.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "turbo": "^2.10.4"
  }
}
