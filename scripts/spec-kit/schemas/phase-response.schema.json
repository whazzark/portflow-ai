{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "message", "commit_message"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["question", "checkpoint", "completed", "blocked", "findings"]
    },
    "message": {
      "type": "string"
    },
    "commit_message": {
      "type": ["string", "null"]
    }
  }
}
